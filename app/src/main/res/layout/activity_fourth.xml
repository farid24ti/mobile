<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".pertemuan_4.FourthActivity">

    <!-- CARD BESAR -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTombol"
        android:layout_width="283dp"
        android:layout_height="223dp"
        android:layout_marginTop="28dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- KOTAK KECIL DI DALAM CARD BESAR -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDalam"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp">

            <!-- CONSTRAINT LAYOUT DALAM KOTAK -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- TOMBOL 1 -->
                <Button
                    android:id="@+id/btn1"
                    android:layout_width="90dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="12dp"
                    android:text="Tombol 1"
                    android:textSize="10sp"
                    android:padding="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- SHOW SNACKBAR -->
                <Button
                    android:id="@+id/btnShowSnackbar"
                    android:layout_width="95dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="2dp"
                    android:backgroundTint="#0097A7"
                    android:text="Show Snackbar"
                    android:textSize="10sp"
                    android:padding="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn1" />

                <!-- SHOW ALERT DIALOG -->
                <Button
                    android:id="@+id/btnShowAlertDialog"
                    android:layout_width="105dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="2dp"
                    android:backgroundTint="#303F9F"
                    android:text="Show Alert Dialog"
                    android:textSize="10sp"
                    android:padding="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btnShowSnackbar" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </com.google.android.material.card.MaterialCardView>


    <!-- BUTTON KEMBALI -->
    <Button
        android:id="@+id/btnKembali"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:backgroundTint="#E64A19"
        android:text="Kembali"
        android:textColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardTombol" />

</androidx.constraintlayout.widget.ConstraintLayout>